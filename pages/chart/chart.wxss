.container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding: 20rpx 28rpx 60rpx;
}

/* 顶部月份切换胶囊 */
.month-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.month-capsule {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-light);
}

.calendar-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
}

.dropdown-arrow {
  font-size: 18rpx;
  color: var(--text-muted);
  transform: scale(0.85);
}

/* 四维财务概览卡片 */
.overview-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 34rpx 32rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  margin-bottom: 24rpx;
}

.overview-top {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.overview-label {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.overview-main-amount {
  font-size: 60rpx;
  font-weight: 800;
  color: var(--expense);
  line-height: 1.1;
}

.overview-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.grid-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.grid-val.income {
  color: var(--primary);
}

.grid-divider {
  width: 1rpx;
  height: 44rpx;
  background-color: var(--border-light);
}

/* 通用标题行 */
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.card-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 环形图卡片 */
.chart-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  margin-bottom: 24rpx;
}

.donut-chart-container {
  position: relative;
  width: 260px;
  height: 260px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut-canvas {
  width: 260px;
  height: 260px;
}

.donut-center-info {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.donut-center-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 4rpx;
}

.donut-center-val {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
}

/* 图例矩阵 */
.legend-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.legend-name {
  font-size: 24rpx;
  color: var(--text-sub);
  max-width: 110rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-pct {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-left: 6rpx;
}

/* 智能洞察卡片 */
.insights-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  margin-bottom: 24rpx;
}

.insights-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.insight-item {
  display: flex;
  align-items: center;
  background-color: #F8FAFC;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
}

.insight-icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.max-icon {
  background-color: rgba(245, 158, 11, 0.15);
}

.freq-icon {
  background-color: rgba(244, 63, 94, 0.15);
}

.insight-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.insight-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.insight-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 排行榜卡片 */
.rankings-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  margin-bottom: 24rpx;
}

.rank-breakdown-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.rank-row {
  display: flex;
  align-items: center;
}

.rank-index {
  width: 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-muted);
  text-align: center;
  margin-right: 12rpx;
}

.rank-index.top {
  color: var(--expense);
}

.rank-cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.rank-cat-icon .iconfont {
  font-size: 36rpx;
}

.rank-detail-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rank-line-1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.rank-name-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.rank-cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.rank-cat-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.rank-cat-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.rank-bar-bg {
  width: 100%;
  height: 12rpx;
  background-color: #F1F5F9;
  border-radius: var(--radius-full);
  overflow: hidden;
}

.rank-bar-progress {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.4s ease;
}

/* 空状态 */
.empty-chart-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.65;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

