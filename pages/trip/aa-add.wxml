<view class="container {{showKeypad ? 'has-keypad' : ''}}">
  <!-- 顶部状态信息 -->
  <view class="header-card">
    <view class="header-title">记一笔集体消费</view>
    <view class="header-sub">{{trip.title}} · {{trip.destination || '旅行'}}</view>
  </view>

  <view class="form-container">
    <!-- 金额卡片（模拟金额显示屏，点击呼起自定义键盘） -->
    <view class="form-card amount-card {{showKeypad ? 'amount-focused' : ''}}" bindtap="openKeypad">
      <view class="amount-label-row">
        <text class="label">消费金额 (元)</text>
        <view class="amount-badge-wrap" wx:if="{{evalPreview}}">
          <text class="eval-preview font-number">{{evalPreview}}</text>
        </view>
      </view>

      <view class="amount-display-screen">
        <text class="currency">¥</text>
        <view class="amount-val-box">
          <text class="amount-expr-text font-number">{{amountExpr || '0.00'}}</text>
          <text class="blinking-cursor" wx:if="{{showKeypad}}">|</text>
        </view>
      </view>

      <view class="split-preview" wx:if="{{amount > 0}}">
        <text class="split-icon">💡</text>
        <text class="split-text">共 {{participants.length}} 人分摊，预计每人平摊 </text>
        <text class="split-highlight">¥{{perPersonAmount}}</text>
      </view>
    </view>

    <!-- 基础详情卡片（消费项目 + 快捷分类选择 + 日期） -->
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">消费项目</text>
        <view class="input-with-clear">
          <input 
            class="form-input" 
            placeholder="选择下方分类或直接手写" 
            placeholder-class="placeholder" 
            value="{{title}}" 
            bindinput="onTitleInput" 
            bindfocus="onTitleFocus"
          />
          <view class="clear-btn" wx:if="{{title}}" catchtap="clearTitle">✕</view>
        </view>
      </view>

      <!-- 快捷常用分类横滑选择栏 -->
      <view class="quick-category-section">
        <view class="quick-cat-head">
          <text class="quick-cat-tip">支出类型快捷选择：</text>
          <view class="more-cat-link" bindtap="openCategoryModal">全部分类 ›</view>
        </view>
        <scroll-view scroll-x class="quick-cat-scroll" enable-flex>
          <view 
            wx:for="{{popularCategories}}" 
            wx:key="id" 
            class="quick-cat-pill {{title === item.name || selectedCategoryId === item.id ? 'active' : ''}}" 
            bindtap="selectQuickCategory"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-icon="{{item.icon}}"
          >
            <text class="iconfont icon-a-068_{{item.icon}} cat-pill-icon"></text>
            <text class="cat-pill-name">{{item.name}}</text>
          </view>
          <view class="quick-cat-pill more-pill" bindtap="openCategoryModal">
            <text class="iconfont icon-a-068_qita-60 cat-pill-icon"></text>
            <text class="cat-pill-name">更多 ▾</text>
          </view>
        </scroll-view>
      </view>

      <view class="form-divider"></view>

      <view class="form-item border-none">
        <text class="form-label">消费时间</text>
        <view class="datetime-picker-wrap">
          <picker mode="date" value="{{dateOnly}}" bindchange="onDateChange">
            <view class="picker-chip date-chip">
              <text class="picker-chip-text">{{dateOnly}}</text>
              <text class="picker-chip-icon">📅</text>
            </view>
          </picker>
          <picker mode="time" value="{{timeOnly}}" bindchange="onTimeChange">
            <view class="picker-chip time-chip">
              <text class="picker-chip-text">{{timeOnly}}</text>
              <text class="picker-chip-icon">⏰</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 付款人选择 -->
    <view class="form-card">
      <view class="section-head">
        <text class="section-title">谁先垫付的？</text>
        <text class="section-tip">单选垫付人</text>
      </view>
      <view class="pills-grid">
        <view 
          wx:for="{{trip.members}}" 
          wx:key="*this" 
          class="member-pill {{payer === item ? 'active' : ''}}" 
          data-name="{{item}}" 
          bindtap="selectPayer"
        >
          <text class="pill-name">{{item}}</text>
          <text class="pill-check" wx:if="{{payer === item}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 参与平摊人 -->
    <view class="form-card">
      <view class="section-head">
        <view class="section-title-wrap">
          <text class="section-title">谁参与了分摊？</text>
          <text class="badge">{{participants.length}}/{{trip.members.length}}人</text>
        </view>
        <view class="action-link" bindtap="selectAllParticipants">全员参与</view>
      </view>
      <view class="pills-grid">
        <view 
          wx:for="{{trip.members}}" 
          wx:key="*this" 
          class="member-pill multi {{participants.indexOf(item) !== -1 ? 'active-multi' : ''}}" 
          data-name="{{item}}" 
          bindtap="toggleParticipant"
        >
          <view class="checkbox {{participants.indexOf(item) !== -1 ? 'checked' : ''}}"></view>
          <text class="pill-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 备注信息 -->
    <view class="form-card">
      <view class="form-item border-none">
        <text class="form-label">备注说明</text>
        <input 
          class="form-input" 
          placeholder="选填（如：小张自费饮料除外）" 
          placeholder-class="placeholder" 
          value="{{remarks}}" 
          bindinput="onRemarksInput" 
          bindfocus="onRemarksFocus"
        />
      </view>
    </view>

    <!-- 提交保存按钮 -->
    <view class="btn-wrap">
      <button class="submit-btn" bindtap="submitExpense">记入小队账单</button>
    </view>
  </view>

  <!-- 底部固定 4×4 自定义金融数字键盘 -->
  <view class="custom-keypad-panel" wx:if="{{showKeypad}}">
    <!-- 键盘控制顶栏 -->
    <view class="keypad-toolbar">
      <view class="keypad-tip">
        <text class="tip-icon">⌨️</text>
        <text class="tip-text">支持输入金额与 + - 计算</text>
      </view>
      <view class="keypad-close-btn touch-active" bindtap="closeKeypad">
        <text class="close-text">收起键盘</text>
        <text class="close-arrow">▾</text>
      </view>
    </view>

    <!-- 4×4 经典键位区 -->
    <view class="keypad-grid">
      <!-- 左侧 3 列数字与符号按键 -->
      <view class="keypad-digits">
        <view class="key-row">
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="1">1</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="2">2</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="3">3</view>
        </view>
        <view class="key-row">
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="4">4</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="5">5</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="6">6</view>
        </view>
        <view class="key-row">
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="7">7</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="8">8</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="9">9</view>
        </view>
        <view class="key-row">
          <view class="key-btn symbol-key touch-active" bindtap="handleKeypad" data-key=".">.</view>
          <view class="key-btn digit-key touch-active" bindtap="handleKeypad" data-key="0">0</view>
          <view class="key-btn symbol-key del-key touch-active" bindtap="handleKeypad" data-key="del">
            <text class="del-icon">⌫</text>
          </view>
        </view>
      </view>

      <!-- 右侧 1 列计算与确定复合操作区 -->
      <view class="keypad-ops">
        <view class="key-btn op-key touch-active" bindtap="handleKeypad" data-key="+">+</view>
        <view class="key-btn op-key touch-active" bindtap="handleKeypad" data-key="-">-</view>
        <view 
          class="key-btn primary-action-key touch-active" 
          bindtap="handleKeypadAction"
        >
          <text class="action-btn-text">{{isOperating ? '=' : '确定'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全量个人支出分类选择抽屉 -->
  <view class="drawer-mask" wx:if="{{showCategoryModal}}" bindtap="closeCategoryModal">
    <view class="drawer-panel" catchtap="true">
      <view class="drawer-header">
        <view class="drawer-title-box">
          <text class="drawer-title">选择消费类型</text>
          <text class="drawer-sub">涵盖个人记账全部支出选项</text>
        </view>
        <view class="drawer-close-btn touch-active" bindtap="closeCategoryModal">✕</view>
      </view>

      <scroll-view scroll-y class="drawer-cat-scroll">
        <view class="drawer-cat-grid">
          <view 
            wx:for="{{allCategories}}" 
            wx:key="id" 
            class="drawer-cat-item touch-active {{title === item.name || selectedCategoryId === item.id ? 'active' : ''}}"
            bindtap="selectDrawerCategory"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-icon="{{item.icon}}"
          >
            <view class="drawer-icon-wrap">
              <text class="iconfont icon-a-068_{{item.icon}}"></text>
            </view>
            <text class="drawer-cat-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
