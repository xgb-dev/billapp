<view class="container">
  <!-- 顶部小队活动概览卡片 -->
  <view class="trip-hero-card">
    <view class="hero-top">
      <view class="hero-meta-left">
        <view class="hero-tag {{tripStatus === 'CLOSED' || tripStatus === 'finished' ? 'tag-finished' : 'tag-active'}}">
          {{tripStatus === 'CLOSED' || tripStatus === 'finished' ? '⚪ 已结束' : '🟢 进行中'}}
        </view>
        <view class="hero-status-sub {{settlementInfo.isAllSettled ? 'status-green' : 'status-amber'}}" wx:if="{{tripStatus === 'CLOSED' || tripStatus === 'finished'}}">
          {{settlementInfo.isAllSettled ? '已平账' : '待平账'}}
        </view>
      </view>
      <view class="hero-actions-right">
        <!-- 结束行程按钮（仅队长在 ACTIVE 时可用） -->
        <view class="hero-sub-btn touch-active" bindtap="handleFinishTrip" wx:if="{{isCreator && (tripStatus === 'ACTIVE' || tripStatus === 'ongoing')}}">
          <text class="sub-btn-txt">结束行程</text>
        </view>
        <!-- 重新开启按钮（仅队长在 CLOSED 时可用） -->
        <view class="hero-sub-btn reopen touch-active" bindtap="handleReopenTrip" wx:if="{{isCreator && (tripStatus === 'CLOSED' || tripStatus === 'finished')}}">
          <text class="sub-btn-txt">重新开启</text>
        </view>
        <!-- 解散行程按钮（仅队长可用：ACTIVE 时点击会提示先结束，CLOSED 时检查 AA） -->
        <view class="hero-del-btn touch-active" bindtap="handleDeleteTrip" wx:if="{{isCreator}}">
          <text class="del-icon">🗑️</text>
          <text class="del-txt">解散</text>
        </view>
        <!-- 离开小队按钮（普通队员可用） -->
        <view class="hero-leave-btn touch-active" bindtap="handleLeaveTrip" wx:else>
          <text class="leave-icon">🚪</text>
          <text class="leave-txt">离开小队</text>
        </view>
      </view>
    </view>

    <!-- 活动标题 -->
    <view class="hero-title">{{trip.title}}</view>

    <!-- 活动基础元信息行（目的地与出行日期胶囊，空间宽裕不拥挤） -->
    <view class="hero-meta-row">
      <view class="hero-dest-wrap">
        <text class="hero-dest-icon">📍</text>
        <text class="hero-dest-text">{{trip.destination || '目的地待定'}}</text>
      </view>
      
      <view class="hero-date-badge {{isCreator && (tripStatus === 'ACTIVE' || tripStatus === 'ongoing') ? 'editable touch-active' : ''}}" bindtap="{{isCreator && (tripStatus === 'ACTIVE' || tripStatus === 'ongoing') ? 'openEditDatesModal' : ''}}">
        <text class="hero-date-icon">📅</text>
        <text class="hero-date-text font-number">{{trip.startDate ? (trip.startDate + ' ~ ' + trip.endDate) : (isCreator ? '设置行程日期' : '未设日期')}}</text>
        <text class="hero-date-edit-icon" wx:if="{{trip.startDate && isCreator && (tripStatus === 'ACTIVE' || tripStatus === 'ongoing')}}">✎</text>
      </view>
    </view>

    <!-- 6 位加入口令与邀请栏 -->
    <view class="invite-code-card" wx:if="{{trip.code}}">
      <view class="code-left-wrap">
        <text class="code-icon">🔑</text>
        <text class="code-label">小队口令</text>
        <text class="code-badge font-number">{{trip.code}}</text>
      </view>
      <view class="code-right-wrap">
        <view class="code-btn copy-btn touch-active" bindtap="copyInviteCode">复制</view>
        <button class="code-btn share-btn touch-active" open-type="share">微信邀请</button>
      </view>
    </view>

    <!-- 成员小头像/标签列表 -->
    <view class="members-bar">
      <view class="members-label">小队成员 ({{trip.members.length}}人):</view>
      <view class="members-tags">
        <view 
          class="member-tag {{item === myMemberName ? 'me-tag' : ''}} touch-active" 
          wx:for="{{trip.members}}" 
          wx:key="*this"
          bindtap="openEditMemberNameModal"
          data-name="{{item}}"
          data-index="{{index}}"
        >
          <text>{{item}}</text>
          <text class="me-tag-badge" wx:if="{{item === myMemberName}}">我</text>
        </view>
        <!-- 已退出小队的成员标签 -->
        <view class="member-tag left-member-tag" wx:for="{{trip.leftMembers}}" wx:key="name">
          <text>{{item.name}}</text>
          <text class="left-tag-sub">已退队</text>
        </view>
        <!-- 详情页动态追加成员入口 -->
        <view class="member-tag add-tag touch-active" bindtap="openAddMemberModal">
          <text>+ 添加</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史已结束行程提示条 -->
  <view class="finished-trip-banner" wx:if="{{tripStatus === 'CLOSED' || tripStatus === 'finished'}}">
    <text class="ftb-icon">ℹ️</text>
    <view class="ftb-content">
      <text class="ftb-title">此行程已归档至历史记录</text>
      <text class="ftb-desc">{{settlementInfo.isAllSettled ? '账单已全部平账结清，随时可回顾查账。' : '尚有 ' + settlementInfo.pendingCount + ' 笔待结清转账（¥' + settlementInfo.pendingAmount + '），仍可正常结算。'}}</text>
    </view>
    <view class="ftb-btn touch-active" bindtap="goToHistoryDetail">
      <text>专属账单回顾 ›</text>
    </view>
  </view>

  <!-- 3大核心模块 Tab 切换栏 -->
  <view class="tab-nav">
    <view 
      class="tab-item {{currentTab === 'checklist' ? 'active' : ''}}" 
      data-tab="checklist" 
      bindtap="switchTab"
    >
      <text class="tab-icon">📋</text>
      <text class="tab-text">旅行清单</text>
      <text class="tab-count" wx:if="{{checklistProgress.total > 0}}">({{checklistProgress.checked}}/{{checklistProgress.total}})</text>
    </view>

    <view 
      class="tab-item {{currentTab === 'aa' ? 'active' : ''}}" 
      data-tab="aa" 
      bindtap="switchTab"
    >
      <text class="tab-icon">💳</text>
      <text class="tab-text">AA 结算</text>
      <text class="tab-count" wx:if="{{trip.expenses.length > 0}}">({{trip.expenses.length}})</text>
    </view>

    <view 
      class="tab-item {{currentTab === 'decision' ? 'active' : ''}}" 
      data-tab="decision" 
      bindtap="switchTab"
    >
      <text class="tab-icon">🎯</text>
      <text class="tab-text">决策转盘</text>
    </view>
  </view>

  <!-- ======================== TAB 1: 旅行清单 ======================== -->
  <view class="tab-content" wx:if="{{currentTab === 'checklist'}}">
    <!-- 清单准备进度看板 -->
    <view class="progress-card">
      <view class="progress-info">
        <view class="progress-title">行前装备准备进度</view>
        <view class="progress-ratio">{{checklistProgress.checked}} / {{checklistProgress.total}} 项</view>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{checklistProgress.percent}}%;"></view>
      </view>
      <view class="progress-footer">
        <text class="progress-pct">{{checklistProgress.percent}}% 完成</text>
        <text class="progress-cheer">{{checklistProgress.percent === 100 ? '🎉 装备全部齐备，随时出发！' : '打包完成即可打勾确认'}}</text>
      </view>
    </view>

    <!-- 分类横向滚动栏 -->
    <scroll-view class="category-scroll" scroll-x="true">
      <view 
        wx:for="{{categories}}" 
        wx:key="*this" 
        class="cat-chip {{selectedCategoryFilter === item ? 'active' : ''}}" 
        data-cat="{{item}}" 
        bindtap="selectCategoryFilter"
      >
        {{item}}
      </view>
    </scroll-view>

    <!-- 清单明细列表 -->
    <view class="checklist-box">
      <view 
        wx:for="{{filteredChecklist}}" 
        wx:key="id" 
        class="check-item {{item.checked ? 'is-done' : ''}}"
      >
        <view class="check-box" data-id="{{item.id}}" bindtap="toggleChecklistItem">
          <view class="custom-checkbox {{item.checked ? 'checked' : ''}}"></view>
        </view>
        <view class="item-body" data-id="{{item.id}}" bindtap="toggleChecklistItem">
          <view class="item-title {{item.checked ? 'line-through' : ''}}">{{item.title}}</view>
          <view class="item-meta">
            <text class="item-cat">{{item.category}}</text>
            <text class="item-assignee">👤 {{item.assignee || '所有人'}}</text>
          </view>
        </view>
        <view class="del-btn" wx:if="{{tripStatus !== 'CLOSED' && tripStatus !== 'finished'}}" data-id="{{item.id}}" bindtap="deleteChecklistItem">✕</view>
      </view>

      <view class="empty-state" wx:if="{{filteredChecklist.length === 0}}">
        <text class="empty-icon">🎒</text>
        <text class="empty-text">该分类下还没有清单项</text>
      </view>
    </view>

    <!-- 底部添加按钮（仅进行中可添加） -->
    <view class="fab-bar" wx:if="{{tripStatus !== 'CLOSED' && tripStatus !== 'finished'}}">
      <button class="fab-btn" bindtap="openAddChecklist">➕ 添加自备 / 公用物品</button>
    </view>
  </view>

  <!-- ======================== TAB 2: AA 结算 ======================== -->
  <view class="tab-content" wx:if="{{currentTab === 'aa'}}">
    <!-- 支出概览看板 -->
    <view class="aa-summary-card">
      <view class="summary-top">
        <view>
          <view class="sum-label">小队总支出</view>
          <view class="sum-amount">¥{{settlement.totalExpense}}</view>
        </view>
        <view class="sum-stats">
          <view class="stat-pill">{{trip.members.length}} 人同行</view>
          <view class="stat-pill">{{trip.expenses.length}} 笔消费</view>
          <view class="stat-pill {{settlement.isAllSettled ? 'pill-success' : ''}}" wx:if="{{settlement.transferPlans.length > 0}}">
            {{settlement.isAllSettled ? '🎉 全部已结' : (settlement.pendingCount + ' 笔待结')}}
          </view>
        </view>
      </view>
      <view class="aa-actions">
        <button class="action-btn btn-primary" wx:if="{{tripStatus !== 'CLOSED' && tripStatus !== 'finished'}}" bindtap="goToAddAA">➕ 记一笔集体消费</button>
        <button class="action-btn btn-outline" bindtap="copySettlementText">📋 复制群对账单</button>
      </view>
    </view>

    <!-- 极简清算结果（谁给谁转多少） -->
    <view class="section-card">
      <view class="card-head">
        <view class="card-head-title">
          <text class="head-icon">⚡</text>
          <text>智能清算方案（最少转账路径）</text>
        </view>
        <view class="head-action-wrap" wx:if="{{settlement.transferPlans.length > 0}}">
          <view 
            class="batch-settle-btn touch-active" 
            bindtap="handleSettleAllTransfers" 
            wx:if="{{settlement.pendingCount > 0}}"
          >
            一键全结
          </view>
          <view 
            class="batch-settle-btn outline touch-active" 
            bindtap="handleResetAllTransfers" 
            wx:else
          >
            重置结清
          </view>
        </view>
      </view>

      <!-- 全部结清庆祝横幅 -->
      <view class="all-done-banner" wx:if="{{settlement.isAllSettled && settlement.transferPlans.length > 0}}">
        <text class="banner-icon">🎉</text>
        <text class="banner-text">所有转账方案均已确认结清！</text>
      </view>

      <view class="transfer-compact-list" wx:if="{{settlement.transferPlans.length > 0}}">
        <view class="tc-item {{item.isSettled ? 'settled' : ''}}" wx:for="{{settlement.transferPlans}}" wx:key="id">
          <!-- 转账两端 -->
          <view class="tc-route">
            <view class="tc-person from">
              <view class="tc-dot red"></view>
              <text class="tc-name">{{item.from}}</text>
            </view>
            <text class="tc-arrow">转给</text>
            <view class="tc-person to">
              <view class="tc-dot green"></view>
              <text class="tc-name">{{item.to}}</text>
            </view>
          </view>

          <!-- 转账金额 -->
          <view class="tc-amt {{item.isSettled ? 'amt-settled' : ''}}">
            <text class="tc-yen">¥</text>
            <text class="tc-val font-number">{{item.amount}}</text>
          </view>

          <!-- 操作按钮 -->
          <view 
            class="tc-btn {{item.isSettled ? 'btn-rev' : 'btn-do'}} touch-active" 
            data-planid="{{item.id}}" 
            bindtap="toggleSettleTransfer"
          >
            <text class="tc-btn-text">{{item.isSettled ? '✓ 已结' : '标记已结'}}</text>
          </view>
        </view>
      </view>

      <view class="all-settled-box" wx:if="{{settlement.transferPlans.length === 0}}">
        <text class="settled-icon">🎉</text>
        <text class="settled-title">账目已全部平账结清！</text>
        <text class="settled-sub">暂无任何未结转账需求</text>
      </view>

      <!-- 同步行程花销到个人账单入口卡片 -->
      <view class="sync-bills-card touch-active" bindtap="handleSyncToPersonalBills">
        <view class="sbc-left">
          <text class="sbc-icon">📥</text>
          <view class="sbc-info">
            <text class="sbc-title">同步花销到个人账单</text>
            <text class="sbc-desc">将你在本行程中的 AA 个人花销自动记入个人记账流水</text>
          </view>
        </view>
        <view class="sbc-btn">立即同步</view>
      </view>
    </view>

    <!-- 个人收支一览表 -->
    <view class="section-card">
      <view class="card-head">
        <view class="card-head-title">
          <text class="head-icon">👥</text>
          <text>成员收支明细</text>
        </view>
      </view>
      <view class="member-balance-list">
        <view class="member-balance-row" wx:for="{{settlement.memberSummaries}}" wx:key="name">
          <view class="m-left">
            <view class="avatar-tiny">{{item.name[0]}}</view>
            <text class="m-name">{{item.name}}</text>
          </view>
          <view class="m-middle">
            <text class="m-sub">已付 ¥{{item.paid}} / 应摊 ¥{{item.owed}}</text>
          </view>
          <view class="m-right">
            <view class="balance-tag {{item.isSettledUp ? 'tag-settled' : (item.isCreditor ? 'tag-green' : (item.isDebtor ? 'tag-red' : 'tag-gray'))}}">
              {{item.isSettledUp ? '已结清 ✓' : (item.isCreditor ? ('待收 +¥' + item.pendingCredit) : (item.isDebtor ? ('待还 ¥' + item.pendingDebt) : '已结清'))}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 消费流水列表 -->
    <view class="section-card">
      <view class="card-head">
        <view class="card-head-title">
          <text class="head-icon">🧾</text>
          <text>小队消费明细流水 ({{trip.expenses.length}})</text>
        </view>
      </view>

      <view class="expense-list" wx:if="{{trip.expenses.length > 0}}">
        <view class="expense-card" wx:for="{{trip.expenses}}" wx:key="id">
          <view class="exp-main">
            <view class="exp-info">
              <view class="exp-title-row">
                <text class="iconfont icon-a-068_{{item.icon}} exp-cat-icon" wx:if="{{item.icon}}"></text>
                <text class="exp-title">{{item.title}}</text>
              </view>
              <view class="exp-detail">
                <text class="payer-badge">{{item.payer}} 先垫付</text>
                <text class="parts-badge">{{item.participants.length}}人分摊</text>
                <text class="exp-date">{{item.date}}</text>
              </view>
              <view class="exp-remark" wx:if="{{item.remarks}}">💬 {{item.remarks}}</view>
            </view>
            <view class="exp-cost">
              <text class="exp-amt">¥{{item.amount}}</text>
              <view class="del-link" data-id="{{item.id}}" bindtap="deleteExpense">删除</view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{trip.expenses.length === 0}}">
        <text class="empty-icon">📝</text>
        <text class="empty-text">点击上方“记一笔集体消费”，开始清算吧！</text>
      </view>
    </view>
  </view>

  <!-- ======================== TAB 3: 多人决策 & 随机转盘 ======================== -->
  <view class="tab-content" wx:if="{{currentTab === 'decision'}}">
    <!-- 主题选择横向胶囊 + 新建按钮 -->
    <view class="decision-selector">
      <scroll-view class="decision-scroll" scroll-x="true" enable-flex="true">
        <view 
          wx:for="{{trip.decisions}}" 
          wx:key="id" 
          class="decision-chip {{activeDecisionIndex === index ? 'active' : ''}}" 
          data-index="{{index}}" 
          bindtap="selectDecisionTab"
        >
          {{item.title}}
        </view>
        <view class="decision-chip add-chip" bindtap="openAddDecision">➕ 新建决策</view>
      </scroll-view>
    </view>

    <!-- 当前决策卡片 -->
    <view class="decision-main-card" wx:if="{{trip.decisions[activeDecisionIndex]}}">
      <view class="decision-header">
        <view class="dh-title-wrap">
          <text class="dh-title">{{trip.decisions[activeDecisionIndex].title}}</text>
          <text class="preset-badge" wx:if="{{trip.decisions[activeDecisionIndex].isPreset}}">通用模板</text>
        </view>
        <view 
          class="dh-del" 
          data-index="{{activeDecisionIndex}}" 
          bindtap="deleteDecision" 
          wx:if="{{!trip.decisions[activeDecisionIndex].isPreset && trip.decisions.length > 1}}"
        >
          删除主题
        </view>
      </view>

      <!-- 选项投票展示列表 -->
      <view class="options-container">
        <view 
          class="opt-row {{trip.decisions[activeDecisionIndex].voters && trip.decisions[activeDecisionIndex].voters[myMemberName] === item.id ? 'my-voted' : ''}}" 
          wx:for="{{trip.decisions[activeDecisionIndex].options}}" 
          wx:key="id"
        >
          <view class="opt-content">
            <view class="opt-name-wrap">
              <text class="opt-name">{{item.text}}</text>
              <text class="my-voted-tag" wx:if="{{trip.decisions[activeDecisionIndex].voters && trip.decisions[activeDecisionIndex].voters[myMemberName] === item.id}}">我已投</text>
            </view>
            <view class="opt-count">{{item.votes || 0}} 票</view>
          </view>
          <view 
            class="opt-vote-btn {{trip.decisions[activeDecisionIndex].voters && trip.decisions[activeDecisionIndex].voters[myMemberName] === item.id ? 'voted' : ''}} touch-active" 
            data-optid="{{item.id}}" 
            bindtap="castVote"
          >
            {{trip.decisions[activeDecisionIndex].voters && trip.decisions[activeDecisionIndex].voters[myMemberName] === item.id ? '✓ 已投此项' : '👍 投TA一票'}}
          </view>
        </view>
      </view>

      <!-- 转发微信群邀请快捷投票按钮 -->
      <view class="share-vote-box">
        <button class="share-vote-btn touch-active" open-type="share" data-type="decision">
          <text class="share-icon">🗳️</text>
          <text class="share-text">转发到微信群 · 邀请队员快捷投票</text>
        </button>
      </view>

      <!-- 治愈选择困难：命运大转盘抽签 -->
      <view class="wheel-box">
        <view class="wheel-title">🎲 治愈选择困难 · 命运随机抽签</view>
        <view class="wheel-sub">大家各有偏好？让命运之轮帮你一秒决定！</view>

        <view class="wheel-display {{isSpinning ? 'spinning' : ''}}">
          <text class="wheel-text">{{wheelWinner || trip.decisions[activeDecisionIndex].options[0].text || '???'}}</text>
        </view>

        <button 
          class="spin-btn" 
          bindtap="spinWheel" 
          loading="{{isSpinning}}" 
          disabled="{{isSpinning}}"
        >
          {{isSpinning ? '正在命运抉择中...' : '🎲 立即随机决定'}}
        </button>
      </view>
    </view>
  </view>

  <!-- ======================== 模态弹窗 1: 添加清单项 ======================== -->
  <view class="modal-mask" wx:if="{{showAddChecklistModal}}">
    <view class="modal-box">
      <view class="modal-title">添加行李/待办物品</view>

      <view class="modal-field">
        <text class="modal-label">物品名称</text>
        <input 
          class="modal-input" 
          placeholder="如：防蚊喷雾、冲锋衣、桌游牌" 
          value="{{newChecklistTitle}}" 
          bindinput="onNewChecklistTitleInput" 
        />
      </view>

      <view class="modal-field">
        <text class="modal-label">选择分类</text>
        <view class="modal-chips">
          <view 
            wx:for="{{categories}}" 
            wx:key="*this" 
            wx:if="{{item !== '全部'}}"
            class="modal-chip {{newChecklistCategory === item ? 'active' : ''}}" 
            data-cat="{{item}}" 
            bindtap="onNewChecklistCatSelect"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="modal-field">
        <text class="modal-label">携带人</text>
        <view class="modal-chips">
          <view 
            class="modal-chip {{newChecklistAssignee === '所有人' ? 'active' : ''}}" 
            data-member="所有人" 
            bindtap="onNewChecklistAssigneeSelect"
          >
            所有人
          </view>
          <view 
            wx:for="{{trip.members}}" 
            wx:key="*this" 
            class="modal-chip {{newChecklistAssignee === item ? 'active' : ''}}" 
            data-member="{{item}}" 
            bindtap="onNewChecklistAssigneeSelect"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="modal-btns">
        <button class="m-btn cancel" bindtap="closeAddChecklist">取消</button>
        <button class="m-btn confirm" bindtap="confirmAddChecklistItem">确认添加</button>
      </view>
    </view>
  </view>

  <!-- ======================== 模态弹窗 2: 新建决策主题 ======================== -->
  <view class="modal-mask" wx:if="{{showAddDecisionModal}}">
    <view class="modal-box">
      <view class="modal-title">发起新决策 / 抽签</view>

      <view class="modal-field">
        <text class="modal-label">决策主题</text>
        <input 
          class="modal-input" 
          placeholder="例如：明天晚餐吃什么？下个景点去哪？" 
          value="{{newDecisionTitle}}" 
          bindinput="onDecisionTitleInput" 
        />
      </view>

      <view class="modal-field">
        <text class="modal-label">候选选项 (至少2项)</text>
        <view class="option-inputs">
          <input 
            wx:for="{{newDecisionOptions}}" 
            wx:key="index" 
            class="modal-input opt-inp" 
            placeholder="选项 {{index + 1}}" 
            value="{{item}}" 
            data-index="{{index}}" 
            bindinput="onDecisionOptionInput" 
          />
        </view>
        <view class="add-opt-link" bindtap="addMoreOption">➕ 增加选项</view>
      </view>

      <view class="modal-btns">
        <button class="m-btn cancel" bindtap="closeAddDecision">取消</button>
        <button class="m-btn confirm" bindtap="confirmAddDecision">发起决策</button>
      </view>
    </view>
  </view>

  <!-- ======================== 模态弹窗 4: 详情页添加新成员弹窗 ======================== -->
  <view class="modal-mask" wx:if="{{showAddMemberModal}}">
    <view class="modal-box">
      <view class="modal-title">👥 添加小队新成员</view>
      <view class="modal-sub">添加后该成员将加入小队，可参与AA记账与清单指派</view>
      <view class="modal-field">
        <input 
          class="modal-input" 
          value="{{newMemberInputName}}" 
          bindinput="onNewMemberInput" 
          placeholder="请输入朋友名字/昵称" 
          maxlength="10" 
          focus="{{showAddMemberModal}}" 
        />
      </view>
      <view class="modal-btns">
        <button class="m-btn cancel touch-active" bindtap="closeAddMemberModal">取消</button>
        <button class="m-btn confirm touch-active" bindtap="confirmAddMember">确认添加</button>
      </view>
    </view>
  </view>

  <!-- ======================== 模态弹窗 5: 修改成员名称弹窗 ======================== -->
  <view class="modal-mask" wx:if="{{showEditMemberModal}}">
    <view class="modal-box">
      <view class="modal-title">✏️ 修改成员名称</view>
      <view class="modal-sub">修改后将同步更新该成员在账单与待办中的名称</view>
      <view class="modal-field">
        <input 
          class="modal-input" 
          value="{{editingMemberNewName}}" 
          bindinput="onEditingMemberInput" 
          placeholder="请输入新的成员名字" 
          maxlength="10" 
          focus="{{showEditMemberModal}}" 
        />
      </view>
      <view class="modal-btns">
        <button class="m-btn cancel touch-active" bindtap="closeEditMemberModal">取消</button>
        <button class="m-btn confirm touch-active" bindtap="confirmEditMemberName">保存修改</button>
      </view>
    </view>
  </view>

  <!-- 专属高颜值旅行日历组件（修改计划日期） -->
  <trip-calendar 
    visible="{{showCalendar}}"
    startDate="{{trip.startDate}}"
    endDate="{{trip.endDate}}"
    minDate="{{todayDateStr}}"
    title="调整小队出行日期"
    bind:confirm="onCalendarConfirm"
    bind:close="closeCalendar"
  />

  <!-- ======================== 模态弹窗 7: 结束行程与实际日期校准归档弹窗 ======================== -->
  <view class="modal-mask" wx:if="{{showFinishTripModal}}">
    <view class="modal-box finish-modal-box">
      <view class="modal-title">🏁 结束行程并归档</view>
      <view class="modal-sub">系统已根据账单与计划智能推导实际出行日期，核对后即可归档至历史回忆。</view>
      
      <!-- 原计划与实际出行对比卡片 -->
      <view class="finish-dates-card">
        <view class="fdc-plan-row" wx:if="{{trip.startDate}}">
          <text class="fdc-plan-lbl">原计划：</text>
          <text class="fdc-plan-val font-number">{{trip.startDate}} ~ {{trip.endDate}}</text>
        </view>

        <view class="fdc-actual-title">核对实际出行区间：</view>
        <view class="fdc-pickers-wrap">
          <picker mode="date" value="{{actualStartDate}}" bindchange="onActualStartDateChange">
            <view class="fdc-picker-box">
              <text class="fpb-tag">实际出发</text>
              <text class="fpb-date font-number">{{actualStartDate}}</text>
            </view>
          </picker>
          <text class="fdc-sep">→</text>
          <picker mode="date" value="{{actualEndDate}}" start="{{actualStartDate}}" bindchange="onActualEndDateChange">
            <view class="fdc-picker-box">
              <text class="fpb-tag">实际返程</text>
              <text class="fpb-date font-number">{{actualEndDate}}</text>
            </view>
          </picker>
        </view>

        <view class="fdc-days-tip">
          <text>实际出行共 </text>
          <text class="fdc-days-num font-number">{{actualDaysCount}}</text>
          <text> 天，历史回忆将基于此计算真实日均开销。</text>
        </view>
      </view>

      <view class="modal-btns">
        <button class="m-btn cancel touch-active" bindtap="closeFinishTripModal">暂不结束</button>
        <button class="m-btn confirm touch-active" bindtap="confirmFinishTripWithActualDates">确认结束并归档</button>
      </view>
    </view>
  </view>
</view>

