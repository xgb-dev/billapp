.container {
  min-height: 100vh;
  background-color: #F4F8F5;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 顶部分类 Tab 栏 */
.tab-header {
  display: flex;
  background: #FFFFFF;
  padding: 10rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.tab-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 18rpx;
  transition: all 0.25s ease;
}

.tab-btn.active {
  background: #10B981;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.25);
}

.tab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
}

.tab-btn.active .tab-text {
  color: #FFFFFF;
}

.tab-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #94A3B8;
}

.tab-btn.active .tab-badge {
  color: rgba(255, 255, 255, 0.9);
}

/* 行程卡片列表 */
.trip-list-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.trip-card {
  border-radius: 26rpx;
  padding: 26rpx 28rpx 22rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 1. 进行中行程卡片：山野松绿主题 (生机、在途) */
.trip-card.ongoing-card {
  background: linear-gradient(135deg, #064E3B 0%, #065F46 55%, #047857 100%);
  box-shadow: 0 12rpx 30rpx -6rpx rgba(6, 78, 59, 0.35);
  border: 1rpx solid rgba(52, 211, 153, 0.25);
}

.trip-card.ongoing-card::before {
  content: "";
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(52, 211, 153, 0.18) 0%, rgba(52, 211, 153, 0) 70%);
  pointer-events: none;
}

/* 2. 历史归档行程卡片：沉静石墨深灰蓝 (归档、沉淀) */
.trip-card.history-card {
  background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
  box-shadow: 0 10rpx 26rpx -6rpx rgba(15, 23, 42, 0.22);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

/* 卡片顶部：标题与状态标签 */
.tc-top {
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.tc-title-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tc-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 14rpx;
  letter-spacing: 0.5rpx;
}

.tc-status-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  line-height: 1.2;
}

.tc-status-tag .dot {
  font-size: 16rpx;
}

.tc-status-tag.tag-ongoing {
  background: rgba(255, 255, 255, 0.22);
  color: #A7F3D0;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.tc-status-tag.tag-settled {
  background: rgba(16, 185, 129, 0.2);
  color: #34D399;
  border: 1rpx solid rgba(52, 211, 153, 0.3);
}

.tc-status-tag.tag-unsettled {
  background: rgba(245, 158, 11, 0.2);
  color: #FCD34D;
  border: 1rpx solid rgba(245, 158, 11, 0.35);
}

/* 目的地与时间单行紧凑呈现 */
.tc-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  font-size: 22rpx;
}

.ongoing-card .tc-dest {
  color: #A7F3D0;
  font-weight: 600;
}

.history-card .tc-dest {
  color: #CBD5E1;
  font-weight: 500;
}

.tc-dot {
  color: rgba(255, 255, 255, 0.4);
}

.tc-dates {
  color: rgba(255, 255, 255, 0.7);
}

/* 精简横排数据徽标 (告别多行厚重大灰块) */
.tc-chips-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
  position: relative;
  z-index: 1;
}

.chip-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  color: #E2E8F0;
  font-weight: 500;
}

.chip-pill.chip-green {
  background: rgba(16, 185, 129, 0.2);
  color: #6EE7B7;
  border-color: rgba(52, 211, 153, 0.35);
}

.chip-pill.chip-amber {
  background: rgba(245, 158, 11, 0.2);
  color: #FCD34D;
  border-color: rgba(245, 158, 11, 0.4);
}

.chip-icon {
  font-size: 22rpx;
  line-height: 1;
}

.chip-text {
  font-size: 21rpx;
  line-height: 1;
}

/* 底部操作与身份 (已移除无用口令) */
.tc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 1;
}

.tc-role-badge {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.65);
}

.role-txt {
  font-size: 21rpx;
}

.tc-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.tc-del-btn {
  font-size: 22rpx;
  color: #FCA5A5;
  background: rgba(239, 68, 68, 0.18);
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  font-weight: 600;
}

.tc-hide-btn {
  font-size: 22rpx;
  color: #CBD5E1;
  background: rgba(148, 163, 184, 0.18);
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.ongoing-card .tc-enter-btn {
  font-size: 23rpx;
  font-weight: 700;
  color: #065F46;
  background: #FFFFFF;
  padding: 8rpx 22rpx;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.history-card .tc-enter-btn {
  font-size: 23rpx;
  font-weight: 600;
  color: #34D399;
  background: rgba(16, 185, 129, 0.18);
  border: 1rpx solid rgba(52, 211, 153, 0.3);
  padding: 8rpx 22rpx;
  border-radius: 14rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.empty-btn {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.25);
}

/* 底部悬浮发起按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.05);
  border-top: 1rpx solid #E2E8F0;
  z-index: 100;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.create-btn-icon {
  font-size: 32rpx;
}
