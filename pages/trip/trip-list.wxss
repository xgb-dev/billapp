.container {
  min-height: 100vh;
  background-color: #F8FAFC;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 顶部分类 Tab 栏 */
.tab-header {
  display: flex;
  background: #FFFFFF;
  padding: 10rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  margin-bottom: 28rpx;
  gap: 12rpx;
}

.tab-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 18rpx;
  transition: all 0.25s ease;
}

.tab-btn.active {
  background: #10B981;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.25);
}

.tab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
}

.tab-btn.active .tab-text {
  color: #FFFFFF;
}

.tab-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #94A3B8;
}

.tab-btn.active .tab-badge {
  color: rgba(255, 255, 255, 0.9);
}

/* 行程卡片列表 */
.trip-list-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.trip-card {
  background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.15);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tc-top {
  margin-bottom: 20rpx;
}

.tc-title-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.tc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.tc-status-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.tc-status-tag .dot {
  font-size: 16rpx;
}

.tc-status-tag.tag-ongoing {
  background: rgba(16, 185, 129, 0.2);
  color: #34D399;
  border: 1rpx solid rgba(52, 211, 153, 0.3);
}

.tc-status-tag.tag-settled {
  background: rgba(16, 185, 129, 0.2);
  color: #34D399;
  border: 1rpx solid rgba(52, 211, 153, 0.3);
}

.tc-status-tag.tag-unsettled {
  background: rgba(245, 158, 11, 0.2);
  color: #FBBF24;
  border: 1rpx solid rgba(245, 158, 11, 0.35);
}

.tc-dest {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 6rpx;
}

.tc-dates {
  font-size: 22rpx;
  color: #64748B;
}

/* 汇总信息胶囊 */
.tc-chips {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
}

.chip-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.chip-icon {
  font-size: 24rpx;
}

.chip-text {
  font-size: 23rpx;
  color: #CBD5E1;
}

.chip-item.chip-green .chip-text {
  color: #34D399;
  font-weight: 600;
}

.chip-item.chip-amber .chip-text {
  color: #FBBF24;
  font-weight: 600;
}

/* 底部操作与口令 */
.tc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tc-code {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748B;
}

.code-val {
  color: #38BDF8;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tc-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tc-del-btn {
  font-size: 22rpx;
  color: #FCA5A5;
  background: rgba(239, 68, 68, 0.15);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
}

.tc-hide-btn {
  font-size: 22rpx;
  color: #94A3B8;
  background: rgba(148, 163, 184, 0.15);
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
}

.tc-enter-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #34D399;
  background: rgba(16, 185, 129, 0.18);
  border: 1rpx solid rgba(52, 211, 153, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.empty-btn {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.25);
}

/* 底部悬浮按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.05);
  border-top: 1rpx solid #E2E8F0;
  z-index: 100;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.create-btn-icon {
  font-size: 32rpx;
}
