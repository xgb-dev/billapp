page {
  background-color: #F7F9FC;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #1E293B;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx 80rpx 32rpx;
  box-sizing: border-box;
  transition: padding-bottom 0.2s ease;
}

.container.has-keypad {
  padding-bottom: calc(540rpx + env(safe-area-inset-bottom));
}

/* 顶部信息卡 */
.header-card {
  margin-bottom: 24rpx;
  padding: 10rpx 4rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.5rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 6rpx;
}

/* 表单卡片容器 */
.form-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #F1F5F9;
  transition: all 0.2s ease;
}

/* 金额输入卡片 */
.amount-card {
  background: #FFFFFF;
  border: 2rpx solid #F1F5F9;
}

.amount-card.amount-focused {
  border-color: #10B981;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.12);
}

.amount-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.amount-card .label {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
}

.amount-badge-wrap {
  display: flex;
  align-items: center;
}

.eval-preview {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 600;
  background: #ECFDF5;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #A7F3D0;
}

.amount-display-screen {
  display: flex;
  align-items: baseline;
  border-bottom: 2rpx solid #E2E8F0;
  padding-bottom: 16rpx;
  transition: border-color 0.2s ease;
}

.amount-card.amount-focused .amount-display-screen {
  border-bottom-color: #10B981;
}

.currency {
  font-size: 48rpx;
  font-weight: 700;
  color: #0F172A;
  margin-right: 12rpx;
}

.amount-val-box {
  display: flex;
  align-items: baseline;
  flex: 1;
}

.amount-expr-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1;
}

.blinking-cursor {
  font-size: 56rpx;
  font-weight: 300;
  color: #10B981;
  margin-left: 6rpx;
  animation: cursor-blink 1s infinite;
  transform: translateY(-4rpx);
}

@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.split-preview {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  background: #F0FDF4;
  border-radius: 12rpx;
  border: 1rpx solid #DCFCE7;
}

.split-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.split-text {
  font-size: 24rpx;
  color: #15803D;
}

.split-highlight {
  font-size: 26rpx;
  font-weight: 700;
  color: #10B981;
  margin-left: 6rpx;
}

/* 基础表单项 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8FAFC;
}

.form-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.form-item:first-child {
  padding-top: 0;
}

.border-none {
  border-bottom: none !important;
  padding: 0 !important;
}

.form-label {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
  width: 160rpx;
}

.input-with-clear {
  display: flex;
  align-items: center;
  flex: 1;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #0F172A;
  text-align: right;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #F1F5F9;
  color: #94A3B8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-left: 12rpx;
  line-height: 1;
  flex-shrink: 0;
}

.placeholder {
  color: #94A3B8;
  font-size: 28rpx;
}

/* 快捷常用分类横滑选择栏 */
.quick-category-section {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #E2E8F0;
}

.quick-cat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.quick-cat-tip-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.quick-cat-tip {
  font-size: 22rpx;
  color: #64748B;
}

.quick-cat-selected-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #10B981;
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.more-cat-link {
  font-size: 22rpx;
  color: #10B981;
  font-weight: 600;
}

.quick-cat-scroll {
  white-space: nowrap;
  display: flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.quick-cat-pill {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 26rpx;
  font-size: 24rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #334155;
  margin-right: 14rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.quick-cat-pill:last-child {
  margin-right: 0;
}

.quick-cat-pill .cat-pill-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
  color: #64748B;
}

.quick-cat-pill.active {
  background: #ECFDF5;
  border-color: #10B981;
  color: #047857;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.15);
}

.quick-cat-pill.active .cat-pill-icon {
  color: #10B981;
}

.quick-cat-pill.more-pill {
  background: #F1F5F9;
  border-style: dashed;
  color: #059669;
}

.quick-cat-pill.more-pill .cat-pill-icon {
  color: #059669;
}

.form-divider {
  height: 1rpx;
  background-color: #F8FAFC;
  margin: 18rpx 0 10rpx 0;
}

.datetime-picker-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.picker-chip {
  display: flex;
  align-items: center;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  border: 1rpx solid #E2E8F0;
  box-sizing: border-box;
  gap: 8rpx;
  transition: all 0.15s ease;
}

.picker-chip:active {
  background: #ECFDF5;
  border-color: #10B981;
}

.picker-chip-text {
  font-size: 26rpx;
  color: #0F172A;
  font-weight: 500;
}

.picker-chip-icon {
  font-size: 24rpx;
}

/* 区块标题 */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-tip {
  font-size: 22rpx;
  color: #94A3B8;
}

.badge {
  font-size: 22rpx;
  background: #EEF2F6;
  color: #475569;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.action-link {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 600;
}

/* 药丸选择网格 */
.pills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-pill {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.member-pill.active {
  background: #ECFDF5;
  border-color: #10B981;
  color: #047857;
  font-weight: 600;
}

.pill-name {
  font-size: 26rpx;
}

.pill-check {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 多选药丸 */
.member-pill.multi {
  padding: 12rpx 24rpx;
}

.member-pill.active-multi {
  background: #F0FDF4;
  border-color: #10B981;
  color: #065F46;
  font-weight: 600;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #CBD5E1;
  margin-right: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #10B981;
  border-color: #10B981;
}

.checkbox.checked::after {
  content: '';
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg) translate(1rpx, -1rpx);
}

/* 提交按钮 */
.btn-wrap {
  margin-top: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.25);
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* 底部固定 4×4 自定义金融数字键盘 */
.custom-keypad-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #F1F5F9;
  border-top: 1rpx solid #E2E8F0;
  box-shadow: 0 -8rpx 30rpx rgba(15, 23, 42, 0.08);
  padding: 12rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 999;
  animation: slideUpKeypad 0.22s ease-out;
}

@keyframes slideUpKeypad {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.keypad-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 10rpx 14rpx;
}

.keypad-tip {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #64748B;
}

.tip-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.keypad-close-btn {
  display: flex;
  align-items: center;
  padding: 6rpx 18rpx;
  background: #E2E8F0;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #334155;
  font-weight: 500;
}

.close-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
}

.keypad-grid {
  display: flex;
  gap: 14rpx;
}

.keypad-digits {
  flex: 3;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.key-row {
  display: flex;
  gap: 14rpx;
}

.keypad-ops {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 按键基础样式 */
.key-btn {
  height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 38rpx;
  font-weight: 600;
  user-select: none;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.key-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.digit-key {
  flex: 1;
  background-color: #FFFFFF;
  color: #0F172A;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.05);
}

.symbol-key {
  flex: 1;
  background-color: #E2E8F0;
  color: #0F172A;
  font-size: 40rpx;
}

.del-key {
  font-size: 38rpx;
}

.del-icon {
  font-size: 38rpx;
  line-height: 1;
}

.op-key {
  background-color: #E2E8F0;
  color: #334155;
  font-size: 40rpx;
}

.primary-action-key {
  flex: 2;
  border-radius: 16rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 全量个人支出分类选择抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer-panel {
  background-color: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.15);
  animation: slideUpDrawer 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
}

@keyframes slideUpDrawer {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  display: block;
}

.drawer-sub {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}

.drawer-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F1F5F9;
  color: #64748B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.drawer-cat-scroll {
  max-height: 55vh;
}

.drawer-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 16rpx;
  padding: 10rpx 4rpx;
}

.drawer-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.drawer-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  color: #475569;
  transition: all 0.2s ease;
}

.drawer-icon-wrap .iconfont {
  font-size: 46rpx;
}

.drawer-cat-name {
  font-size: 24rpx;
  color: #475569;
  text-align: center;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-cat-item.active .drawer-icon-wrap {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.35);
  transform: scale(1.06);
}

.drawer-cat-item.active .drawer-cat-name {
  color: #059669;
  font-weight: 700;
}
