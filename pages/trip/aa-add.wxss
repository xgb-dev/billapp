page {
  background-color: #F7F9FC;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #1E293B;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx 60rpx 32rpx;
  box-sizing: border-box;
}

/* 顶部信息卡 */
.header-card {
  margin-bottom: 24rpx;
  padding: 10rpx 4rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.5rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 6rpx;
}

/* 表单卡片容器 */
.form-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #F1F5F9;
}

/* 金额输入卡片 */
.amount-card {
  background: #FFFFFF;
}

.amount-card .label {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
  margin-bottom: 16rpx;
}

.amount-input-box {
  display: flex;
  align-items: baseline;
  border-bottom: 2rpx solid #E2E8F0;
  padding-bottom: 16rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: 700;
  color: #0F172A;
  margin-right: 12rpx;
}

.amount-input {
  font-size: 64rpx;
  font-weight: 700;
  color: #0F172A;
  height: 96rpx;
  min-height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
  flex: 1;
}

.split-preview {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  background: #F0FDF4;
  border-radius: 12rpx;
  border: 1rpx solid #DCFCE7;
}

.split-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.split-text {
  font-size: 24rpx;
  color: #15803D;
}

.split-highlight {
  font-size: 26rpx;
  font-weight: 700;
  color: #10B981;
  margin-left: 6rpx;
}

/* 基础表单项 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8FAFC;
}

.form-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.form-item:first-child {
  padding-top: 0;
}

.border-none {
  border-bottom: none !important;
  padding: 0 !important;
}

.form-label {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
  width: 160rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #0F172A;
  text-align: right;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
}

.placeholder {
  color: #94A3B8;
  font-size: 28rpx;
}

.picker-val {
  font-size: 28rpx;
  color: #0F172A;
  font-weight: 500;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  border: 1rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* 区块标题 */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-tip {
  font-size: 22rpx;
  color: #94A3B8;
}

.badge {
  font-size: 22rpx;
  background: #EEF2F6;
  color: #475569;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.action-link {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 600;
}

/* 药丸选择网格 */
.pills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-pill {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.member-pill.active {
  background: #ECFDF5;
  border-color: #10B981;
  color: #047857;
  font-weight: 600;
}

.pill-name {
  font-size: 26rpx;
}

.pill-check {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 多选药丸 */
.member-pill.multi {
  padding: 12rpx 24rpx;
}

.member-pill.active-multi {
  background: #F0FDF4;
  border-color: #10B981;
  color: #065F46;
  font-weight: 600;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #CBD5E1;
  margin-right: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #10B981;
  border-color: #10B981;
}

.checkbox.checked::after {
  content: '';
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg) translate(1rpx, -1rpx);
}

/* 提交按钮 */
.btn-wrap {
  margin-top: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.25);
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

