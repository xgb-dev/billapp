<view class="container">
  <!-- 基础信息卡片 -->
  <view class="form-card">
    <view class="card-title-row">
      <text class="card-title">🏕️ 活动基础信息</text>
    </view>

    <!-- 活动名称 -->
    <view class="form-item">
      <text class="item-label">活动名称</text>
      <input 
        class="form-input" 
        placeholder="例如：大理洱海自驾游、周末露营" 
        placeholder-class="input-placeholder"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>

    <view class="divider"></view>

    <!-- 目的地 -->
    <view class="form-item">
      <view class="form-item-header">
        <text class="item-label">目的地</text>
        <view class="dest-weather-tag">
          <text class="dwt-icon">🌤️</text>
          <text class="dwt-text">支持关联出行期间天气</text>
        </view>
      </view>
      <input 
        class="form-input" 
        placeholder="例如：云南大理、莫干山" 
        placeholder-class="input-placeholder"
        value="{{destination}}"
        bindinput="onDestInput"
      />
      <view class="dest-weather-hint">
        <text class="dwh-icon">💡</text>
        <text class="dwh-text">填写目的地后，选择出行日历将自动为您展示当地及行程期间的天气预报</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 出行日期（专属高颜值旅行日历唤起卡片） -->
    <view class="form-item date-form-item">
      <view class="date-header-row">
        <text class="item-label">出行日期</text>
        <text class="date-calendar-hint font-number" wx:if="{{daysCount > 0}}">共 {{daysCount}} 天</text>
      </view>
      <view class="calendar-trigger-card touch-active" bindtap="openCalendar">
        <view class="ctc-col ctc-left">
          <text class="ctc-tag">🛫 出发</text>
          <text class="ctc-date font-number {{startDate ? 'active' : ''}}">{{startDate || '请选择'}}</text>
          <text class="ctc-week font-number" wx:if="{{startWeekStr}}">{{startWeekStr}}</text>
        </view>
        <view class="ctc-col ctc-center">
          <text class="ctc-arrow">→</text>
          <text class="ctc-days font-number {{daysCount > 0 ? 'highlight' : 'dim'}}">{{daysCount > 0 ? (daysCount + '天') : '选择日期'}}</text>
        </view>
        <view class="ctc-col ctc-right">
          <text class="ctc-tag">🛬 返程</text>
          <text class="ctc-date font-number {{endDate ? 'active' : ''}}">{{endDate || '请选择'}}</text>
          <text class="ctc-week font-number" wx:if="{{endWeekStr}}">{{endWeekStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成员管理卡片 -->
  <view class="form-card">
    <view class="card-title-row">
      <text class="card-title">👥 小队同行成员</text>
      <text class="card-tip">AA 结算将自动平摊到成员</text>
    </view>

    <view class="members-chips-wrap">
      <view 
        wx:for="{{members}}" 
        wx:key="*this"
        class="member-chip touch-active" 
        bindtap="openEditMemberModal"
        data-index="{{index}}"
        data-name="{{item}}"
      >
        <text class="member-name">{{item}}</text>
        <text class="edit-icon">✎</text>
        <text class="remove-btn" wx:if="{{index > 0}}" catchtap="removeMember" data-index="{{index}}">×</text>
      </view>
    </view>

    <!-- 添加成员输入栏 -->
    <view class="add-member-bar">
      <input 
        class="add-member-input" 
        placeholder="输入朋友名字/昵称" 
        placeholder-class="input-placeholder"
        value="{{newMemberName}}"
        bindinput="onNewMemberInput"
        bindconfirm="addMember"
      />
      <view class="add-btn touch-active" bindtap="addMember">+ 添加</view>
    </view>
  </view>

  <!-- 初始清单模板卡片 -->
  <view class="form-card">
    <view class="card-title-row">
      <text class="card-title">📋 初始行李装备清单</text>
      <text class="card-tip">创建后可随时增删改</text>
    </view>

    <view class="templates-list">
      <block wx:for="{{templates}}" wx:key="key">
        <view 
          class="tpl-card touch-active {{selectedTemplate === item.key ? 'active' : ''}}" 
          bindtap="selectTemplate" 
          data-key="{{item.key}}"
        >
          <view class="tpl-radio">
            <view class="radio-inner" wx:if="{{selectedTemplate === item.key}}"></view>
          </view>
          <view class="tpl-info">
            <text class="tpl-name">{{item.name}}</text>
            <text class="tpl-desc">{{item.desc}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部固定创建按钮 -->
  <view class="bottom-bar">
    <button class="submit-btn touch-active" bindtap="submitCreate">立即开启旅行小队</button>
  </view>

  <!-- 修改成员名称弹窗 -->
  <view class="modal-mask" wx:if="{{showEditMemberModal}}">
    <view class="modal-box">
      <view class="modal-title">✏️ 修改成员名称</view>
      <view class="modal-sub">设置在小队中的显示名字/昵称，方便大家对账</view>
      <view class="modal-field">
        <input 
          class="modal-input" 
          value="{{tempMemberName}}" 
          bindinput="onMemberNameInput" 
          placeholder="请输入成员姓名" 
          maxlength="10" 
          focus="{{showEditMemberModal}}" 
        />
      </view>
      <view class="modal-btns">
        <button class="m-btn cancel touch-active" bindtap="closeEditMemberModal">取消</button>
        <button class="m-btn confirm touch-active" bindtap="confirmEditMember">保存修改</button>
      </view>
    </view>
  </view>

  <!-- 专属高颜值旅行日历组件 -->
  <trip-calendar 
    visible="{{showCalendar}}"
    destination="{{destination}}"
    startDate="{{startDate}}"
    endDate="{{endDate}}"
    minDate="{{minDate}}"
    title="选择小队出行日期"
    bind:confirm="onCalendarConfirm"
    bind:close="closeCalendar"
  />
</view>

