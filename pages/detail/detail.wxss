.container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding: 24rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* 顶部核心卡片 */
.hero-card-wrapper {
  margin-bottom: 24rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
  padding: 50rpx 36rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
}

.hero-card.expense {
  background: linear-gradient(135deg, #F43F5E 0%, #E11D48 100%);
  box-shadow: var(--shadow-expense);
}

.hero-card.income {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: var(--shadow-lg);
}

.category-badge-box {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}

.category-badge-box .iconfont {
  font-size: 56rpx;
  color: #FFFFFF;
}

.type-pill {
  padding: 6rpx 22rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.type-pill.expense {
  background-color: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.type-pill.income {
  background-color: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.amount-wrap {
  display: flex;
  align-items: baseline;
  line-height: 1;
  margin-bottom: 16rpx;
}

.amount-sign {
  font-size: 52rpx;
  font-weight: 700;
  margin-right: 6rpx;
}

.amount-num {
  font-size: 76rpx;
  font-weight: 800;
}

.hero-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 详情属性卡片 */
.detail-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx 32rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.row-left {
  display: flex;
  align-items: center;
}

.row-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}

.row-label {
  font-size: 28rpx;
  color: var(--text-muted);
}

.row-right {
  display: flex;
  align-items: center;
  max-width: 60%;
}

.row-val {
  font-size: 28rpx;
  color: var(--text-main);
  text-align: right;
  word-break: break-all;
}

.main-val {
  font-weight: 600;
}

.detail-divider {
  height: 1rpx;
  background-color: var(--border-light);
}

/* 底部操作按钮栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border-light);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.03);
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.action-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.edit-btn {
  background: #F1F5F9;
  color: var(--text-main);
  border: 1rpx solid #E2E8F0;
}

.delete-btn {
  background: var(--expense-light);
  color: var(--expense);
  border: 1rpx solid rgba(244, 63, 94, 0.2);
}