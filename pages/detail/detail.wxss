.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.status-bar {
  height: var(--status-bar-height);
}

.bill-header {
  padding: 60rpx 30rpx;
  text-align: center;
}

.bill-header.income {
  background: linear-gradient(135deg, #4caf50 0%, #8bc34a 100%);
}

.bill-header.expense {
  background: linear-gradient(135deg, #f44336 0%, #ff9800 100%);
}

.bill-type {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.bill-amount {
  font-size: 80rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.bill-date {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.detail-card {
  background-color: white;
  margin: 30rpx 20rpx;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.detail-label {
  font-size: 30rpx;
  color: #999;
}

.detail-value {
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.category-icon {
  width: 40rpx;
  height: 40rpx;
  font-size: 40rpx;
  margin-right: 10rpx;
}

.detail-divider {
  height: 1px;
  background-color: #f5f5f5;
  margin: 10rpx 0;
}

.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 40rpx;
  background-color: white;
  border-top: 1px solid #eee;
}

.edit-btn, .delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  padding: 25rpx;
  margin: 0 10rpx;
  font-size: 30rpx;
}

.edit-btn {
  background-color: #e8f5e9;
  color: #4caf50;
  border: 1px solid #c8e6c9;
}

.delete-btn {
  background-color: #ffebee;
  color: #f44336;
  border: 1px solid #ffcdd2;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}