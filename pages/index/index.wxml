<view class="container">
  <!-- 1. 品牌与氛围顶栏 (山野同行 青青草) -->
  <view class="brand-hero-header">
    <view class="brand-info">
      <view class="brand-logo-row">
        <text class="brand-badge-icon">{{seasonalBrand.icon || '🍁'}}</text>
        <text class="brand-title">友行A账</text>
        <text class="brand-sub-badge">户外AA同行</text>
      </view>
      <view class="brand-slogan-row">
        <text class="brand-slogan">{{seasonalBrand.slogan || '山野同行 秋意浓'}}</text>
      </view>
    </view>
    <view class="brand-actions">
      <!-- 隐私眼睛切换 -->
      <view class="brand-icon-btn touch-active" bindtap="toggleHideAmount">
        <image class="brand-action-img" src="{{isHideAmount ? '/images/icon-eye-close.svg' : '/images/icon-eye-open.svg'}}"></image>
      </view>
      <!-- 刷新数据 -->
      <view class="brand-icon-btn touch-active" bindtap="refreshPage">
        <image class="brand-action-img brand-refresh-img {{loading ? 'rotating' : ''}}" src="/images/icon-refresh.svg"></image>
      </view>
    </view>
  </view>

  <!-- 2. 核心主业务：旅游记账 · 旅行小队工作台 (HERO SECTION) -->
  <view class="travel-hero-section">
    <!-- 情况 A：有进行中小队行程时展示进行中工作台卡片 -->
    <block wx:if="{{ongoingTrips.length > 0}}">
      <view class="section-title-bar">
        <view class="st-left">
          <text class="st-icon">🏕️</text>
          <text class="st-title">进行中的行程</text>
          <text class="st-count font-number">({{ongoingTrips.length}})</text>
        </view>
        <view class="st-right">
          <!-- 历史行程归档入口 -->
          <view class="st-history-btn touch-active" bindtap="goToTripList">
            <text class="shb-icon">📁</text>
            <text class="shb-txt">历史归档</text>
            <text class="shb-count font-number" wx:if="{{historyTrips.length > 0}}">({{historyTrips.length}})</text>
          </view>
          <!-- 发起新行程入口 -->
          <view class="st-add-btn touch-active" bindtap="goToTripCreate">
            <text class="sab-icon">+</text>
            <text>发起行程</text>
          </view>
        </view>
      </view>

      <!-- 进行中行程卡片列表 -->
      <view 
        class="trip-hero-card touch-active" 
        wx:for="{{ongoingTrips}}" 
        wx:key="id"
        data-id="{{item.id}}" 
        bindtap="goToTripDetail"
      >
        <!-- 卡片顶部：目的地、标题与状态 -->
        <view class="thc-header">
          <view class="thc-header-left">
            <view class="thc-title-row">
              <text class="thc-title">{{item.title}}</text>
              <view class="thc-status-pill">
                <text class="status-pulse-dot"></text>
                <text>进行中</text>
              </view>
            </view>
            <view class="thc-meta-row">
              <text class="thc-dest" wx:if="{{item.destination}}">📍 {{item.destination}}</text>
              <text class="thc-dates" wx:if="{{item.startDate}}">📅 {{item.startDate}} ~ {{item.endDate}}</text>
            </view>
          </view>
          <view class="thc-header-right">
            <view class="thc-del-btn touch-active" catchtap="deleteTripFromHome" data-id="{{item.id}}" data-title="{{item.title}}">
              <text class="thc-del-icon">🗑️</text>
            </view>
          </view>
        </view>

        <!-- 卡片中部：小队开销与对账统计看板 -->
        <view class="thc-dashboard">
          <view class="thc-dash-col">
            <text class="dash-label">小队总开销</text>
            <view class="dash-val-row">
              <text class="dash-unit">¥</text>
              <text class="dash-num font-number">{{item.settlementInfo ? item.settlementInfo.totalExpense : '0.00'}}</text>
            </view>
          </view>
          <view class="thc-dash-divider"></view>
          <view class="thc-dash-col">
            <text class="dash-label">同行小队</text>
            <view class="dash-val-row">
              <text class="dash-num font-number">{{item.members.length}}</text>
              <text class="dash-unit-sub">人</text>
            </view>
          </view>
          <view class="thc-dash-divider"></view>
          <view class="thc-dash-col">
            <text class="dash-label">AA对账状态</text>
            <view class="dash-val-row dash-status-row">
              <text class="dash-status-tag {{item.settlementInfo && item.settlementInfo.isAllSettled ? 'settled' : 'pending'}}">{{item.settlementInfo && item.settlementInfo.isAllSettled ? '✓ 已平账' : (item.settlementInfo.pendingCount + '笔待结')}}</text>
            </view>
          </view>
        </view>

        <!-- 卡片底部：专属快捷操作工具栏 -->
        <view class="thc-actions-bar">
          <!-- 快捷记一笔AA -->
          <view class="thc-action-btn primary-action touch-active" catchtap="goToTripAAAdd" data-id="{{item.id}}">
            <text class="tab-icon">💳</text>
            <text class="tab-text">记一笔AA</text>
          </view>
          <!-- 行李打卡 -->
          <view class="thc-action-btn touch-active" catchtap="goToTripChecklist" data-id="{{item.id}}">
            <text class="tab-icon">📋</text>
            <text class="tab-text">行李清单</text>
          </view>
          <!-- 快速决策 -->
          <view class="thc-action-btn touch-active" catchtap="openTripQuickDecision" data-id="{{item.id}}">
            <text class="tab-icon">🎯</text>
            <text class="tab-text">决策转盘</text>
          </view>
          <!-- 工作台详情 -->
          <view class="thc-action-btn detail-action touch-active">
            <text class="tab-text">工作台</text>
            <text class="tab-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 口令加入小队通栏入口 -->
      <view class="join-quick-strip touch-active" bindtap="openJoinModal">
        <view class="jqs-left">
          <view class="jqs-icon-box">🔑</view>
          <view class="jqs-text-wrap">
            <text class="jqs-main">已有队友口令？快速加入同行小队</text>
            <text class="jqs-sub">输入 6 位邀请码，即刻参与AA对账</text>
          </view>
        </view>
        <view class="jqs-arrow">加入 ›</view>
      </view>
    </block>

    <!-- 情况 B：无进行中行程时：山野同行宣传引导卡片 -->
    <block wx:else>
      <view class="nature-promo-card">
        <view class="npc-top-row">
          <view class="npc-badge">
            <text class="npc-badge-dot">{{seasonalBrand.icon || '🍁'}}</text>
            <text>山野同行 · 友行A账</text>
          </view>
          <view class="npc-history-link touch-active" bindtap="goToTripList">
            <text class="nhl-icon">📁</text>
            <text class="nhl-txt">历史归档</text>
            <text class="nhl-count font-number" wx:if="{{historyTrips.length > 0}}">({{historyTrips.length}})</text>
            <text class="nhl-arrow">›</text>
          </view>
        </view>

        <view class="npc-content">
          <view class="npc-title-box">
            <text class="npc-headline">开启一段山野同行</text>
            <text class="npc-subline">结伴出游账目明晰，{{seasonalBrand.slogan || '山野同行 秋意浓'}}</text>
          </view>

          <!-- 核心功能亮点三联标签 -->
          <view class="npc-features-grid">
            <view class="npc-feat-item">
              <text class="nfi-icon">⚖️</text>
              <text class="nfi-txt">智能AA平账</text>
            </view>
            <view class="npc-feat-item">
              <text class="nfi-icon">🎒</text>
              <text class="nfi-txt">装备行李清单</text>
            </view>
            <view class="npc-feat-item">
              <text class="nfi-icon">🎲</text>
              <text class="nfi-txt">命运决策转盘</text>
            </view>
          </view>
        </view>

        <!-- 行动召唤双按钮 -->
        <view class="npc-actions-row">
          <view class="npc-btn-primary touch-active" bindtap="goToTripCreate">
            <text class="nbp-icon">🏕️</text>
            <text class="nbp-text">发起同行小队</text>
          </view>
          <view class="npc-btn-secondary touch-active" bindtap="openJoinModal">
            <text class="nbs-icon">🔑</text>
            <text class="nbs-text">口令加入同行</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 3. 次要辅助业务：日常个人账本 (精致收拢，不喧宾夺主) -->
  <view class="personal-ledger-section">
    <view class="section-title-bar">
      <view class="st-left">
        <text class="st-icon">📒</text>
        <text class="st-title">日常个人账本</text>
      </view>
      <view class="st-right">
        <view class="st-chart-link touch-active" bindtap="goToChart">
          <text class="scl-icon">📊</text>
          <text class="scl-txt">智能透视</text>
          <text class="scl-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 个人收支卡片 -->
    <view class="ledger-card">
      <view class="ledger-card-top">
        <view class="balance-meta">
          <text class="balance-caption">本月结余 (元)</text>
          <view class="balance-figure-row">
            <text class="b-currency" wx:if="{{!isHideAmount}}">¥</text>
            <text class="b-number font-number">{{isHideAmount ? '****' : totalBalance}}</text>
          </view>
        </view>
        <view class="ledger-sub-stats">
          <view class="sub-stat-item income-item">
            <view class="ss-label-row">
              <text class="ss-dot income-dot"></text>
              <text class="ss-label">本月收入</text>
            </view>
            <text class="ss-val font-number">{{isHideAmount ? '****' : '+¥' + monthIncome}}</text>
          </view>
          <view class="sub-stat-item expense-item">
            <view class="ss-label-row">
              <text class="ss-dot expense-dot"></text>
              <text class="ss-label">本月支出</text>
            </view>
            <text class="ss-val font-number">{{isHideAmount ? '****' : '-¥' + monthExpense}}</text>
          </view>
        </view>
      </view>

      <!-- 快速记账双按钮 -->
      <view class="ledger-action-row">
        <view class="lar-btn expense-btn touch-active" bindtap="goToExpense">
          <view class="lar-icon-wrap exp-wrap">
            <image src="/images/expenses.png" class="lar-img"></image>
          </view>
          <view class="lar-info">
            <text class="lar-title">记支出</text>
            <text class="lar-sub">日常开销随手记</text>
          </view>
        </view>
        <view class="lar-btn income-btn touch-active" bindtap="goToIncome">
          <view class="lar-icon-wrap inc-wrap">
            <image src="/images/income.png" class="lar-img"></image>
          </view>
          <view class="lar-info">
            <text class="lar-title">记收入</text>
            <text class="lar-sub">薪资报销入账</text>
          </view>
        </view>
      </view>

      <!-- 月度消费预算条 -->
      <view class="ledger-budget-strip touch-active" bindtap="setBudget">
        <view class="lbs-header">
          <view class="lbs-title-group">
            <text class="lbs-icon">🎯</text>
            <text class="lbs-title">本月预算</text>
            <text class="lbs-status-tag {{budgetStatus}}" wx:if="{{hasBudget}}">{{isOverBudget ? '已超支' : (budgetPercent >= 80 ? '预警' : '充裕')}}</text>
          </view>
          <view class="lbs-val-group">
            <text class="lbs-val">{{hasBudget ? ('¥' + monthlyBudget) : '未设置'}}</text>
            <text class="lbs-arrow">›</text>
          </view>
        </view>

        <block wx:if="{{hasBudget}}">
          <view class="lbs-progress-track">
            <view class="lbs-progress-bar {{budgetStatus}}" style="width: {{budgetPercent}}%;"></view>
          </view>
          <view class="lbs-footer">
            <text class="lbs-spent">已用 {{budgetPercent}}%（¥{{isHideAmount ? '***' : monthExpense}}）</text>
            <text class="lbs-rem {{budgetStatus}}">{{isOverBudget ? '超支 ¥' + (isHideAmount ? '***' : budgetRemaining) : '剩余 ¥' + (isHideAmount ? '***' : budgetRemaining)}}</text>
          </view>
        </block>
        <view class="lbs-empty" wx:else>
          <text class="lbs-empty-tip">设定消费限额，合理安排日常预算</text>
          <text class="lbs-empty-link">去设置 ›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 4. 最近明细记录 -->
  <view class="recent-bills-section">
    <view class="section-title-bar">
      <view class="st-left">
        <text class="st-icon">🧾</text>
        <text class="st-title">最近账单</text>
      </view>
      <view class="st-right">
        <view class="st-more-link touch-active" bindtap="goToBillList">
          <text class="sml-txt">全部明细</text>
          <text class="sml-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="bills-card">
      <block wx:for="{{recentBills}}" wx:key="id">
        <view class="bill-row touch-active" bindtap="viewBillDetail" data-id="{{item.id}}">
          <view class="bill-avatar {{item.type}}">
            <text class="iconfont icon-a-068_{{item.categoryIcon}}"></text>
          </view>
          <view class="bill-detail">
            <text class="bill-cat-name">{{item.category}}</text>
            <text class="bill-date">{{item.date}}</text>
          </view>
          <view class="bill-val-box">
            <text class="bill-val font-number {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}</text>
          </view>
        </view>
      </block>

      <!-- 空账单状态 -->
      <view class="bills-empty-state" wx:if="{{recentBills.length === 0}}">
        <image src="/images/empty.png" class="empty-img" mode="aspectFit"></image>
        <text class="empty-title">暂无近期账单</text>
        <text class="empty-sub">开启你的第一笔记账吧</text>
      </view>
    </view>
  </view>

  <!-- 5. 口令加入小队弹窗 -->
  <view class="modal-mask" wx:if="{{showJoinModal}}">
    <view class="modal-box">
      <!-- 步骤 1：输入口令并查询 -->
      <block wx:if="{{!queriedTrip}}">
        <view class="modal-title">🔑 口令加入旅行小队</view>
        <view class="modal-sub">输入队友分享给你的 6 位小队口令</view>

        <view class="modal-field">
          <text class="modal-label">6位小队口令</text>
          <input 
            class="modal-input code-inp font-number" 
            placeholder="如：K8P29M" 
            maxlength="10"
            value="{{joinInputCode}}" 
            bindinput="onJoinCodeInput" 
          />
        </view>

        <view class="modal-btns">
          <button class="m-btn cancel touch-active" bindtap="closeJoinModal">取消</button>
          <button class="m-btn confirm touch-active" bindtap="queryTripByInputCode" loading="{{isQueryingCode}}">查询小队</button>
        </view>
      </block>

      <!-- 步骤 2：展示小队信息与成员名单，支持勾选自己或填写新名称 -->
      <block wx:else>
        <view class="modal-title">🧳 找到旅行小队</view>
        
        <!-- 小队信息卡片 -->
        <view class="queried-trip-info">
          <view class="q-trip-main">
            <text class="q-trip-title">{{queriedTrip.title}}</text>
            <text class="q-trip-meta">📍 {{queriedTrip.destination || '目的地待定'}} · 口令: {{queriedTrip.code}}</text>
          </view>
          <view class="q-trip-reset touch-active" bindtap="resetQueriedTrip">
            <text>更换</text>
          </view>
        </view>

        <view class="modal-field-group">
          <view class="modal-label-row">
            <text class="modal-label">请勾选你在小队中的名字：</text>
          </view>
          
          <!-- 成员列表滚动区 -->
          <scroll-view scroll-y class="member-claim-scroll">
            <view class="member-claim-list">
              <!-- 已有成员单选列表 -->
              <view 
                wx:for="{{queriedTrip.members}}" 
                wx:key="*this"
                class="member-claim-item {{selectedMemberName === item && !isNewMember ? 'selected' : ''}}"
                bindtap="selectExistingMember"
                data-name="{{item}}"
              >
                <view class="m-radio {{selectedMemberName === item && !isNewMember ? 'checked' : ''}}">
                  <text class="m-radio-inner" wx:if="{{selectedMemberName === item && !isNewMember}}">✓</text>
                </view>
                <text class="m-name">{{item}}</text>
              </view>

              <!-- 我是新成员（不在名单中） -->
              <view 
                class="member-claim-item new-member-item {{isNewMember ? 'selected' : ''}}"
                bindtap="selectNewMemberOption"
              >
                <view class="m-radio {{isNewMember ? 'checked' : ''}}">
                  <text class="m-radio-inner" wx:if="{{isNewMember}}">✓</text>
                </view>
                <text class="m-name">+ 我是新成员（填写新名字）</text>
              </view>
            </view>
          </scroll-view>

          <!-- 新成员输入框 -->
          <view class="new-member-input-box" wx:if="{{isNewMember}}">
            <input 
              class="modal-input" 
              placeholder="请输入你的姓名/昵称（方便AA对账）" 
              maxlength="10"
              value="{{joinMemberName}}" 
              bindinput="onJoinNameInput" 
              focus="{{isNewMember}}"
            />
          </view>
        </view>

        <view class="modal-btns">
          <button class="m-btn cancel touch-active" bindtap="resetQueriedTrip">更换口令</button>
          <button class="m-btn confirm touch-active" bindtap="confirmJoinTrip">
            {{isNewMember ? '加入并进入' : (selectedMemberName ? '进入小队 (' + selectedMemberName + ')' : '请先勾选身份')}}
          </button>
        </view>
      </block>
    </view>
  </view>

  <!-- 6. 首页快速决策投票弹窗 -->
  <view class="modal-mask quick-decision-mask" wx:if="{{showQuickDecisionModal}}" bindtap="closeQuickDecisionModal">
    <view class="quick-decision-modal" catchtap="true">
      <view class="qdm-header">
        <view class="qdm-meta">
          <text class="qdm-trip-badge">🧳 {{quickDecisionTrip.title}}</text>
          <text class="qdm-my-identity">身份: {{quickDecisionMyName}}</text>
        </view>
        <view class="qdm-close-btn touch-active" bindtap="closeQuickDecisionModal">✕</view>
      </view>

      <view class="qdm-title-wrap">
        <text class="qdm-icon">🎯</text>
        <text class="qdm-title">{{quickDecision.title}}</text>
      </view>
      <view class="qdm-sub">点击选项即可快速投票或切换（再次点击撤销）</view>

      <!-- 选项列表 -->
      <view class="qdm-options-list">
        <view 
          class="qdm-opt-card {{quickDecisionMyVote === item.id ? 'active' : ''}} touch-active" 
          wx:for="{{quickDecision.options}}" 
          wx:key="id"
          bindtap="castQuickVote"
          data-optid="{{item.id}}"
        >
          <view class="qdm-opt-left">
            <view class="qdm-radio {{quickDecisionMyVote === item.id ? 'checked' : ''}}">
              <text wx:if="{{quickDecisionMyVote === item.id}}">✓</text>
            </view>
            <text class="qdm-opt-text">{{item.text}}</text>
          </view>
          <view class="qdm-opt-right">
            <text class="qdm-vote-count font-number" wx:if="{{item.votes > 0}}">{{item.votes}}票</text>
            <text class="qdm-my-tag" wx:if="{{quickDecisionMyVote === item.id}}">我已投</text>
          </view>
        </view>
      </view>

      <!-- 底部操作栏 -->
      <view class="qdm-footer">
        <view class="qdm-detail-link touch-active" bindtap="goToQuickDecisionDetail">
          <text>进入小队工作台详情</text>
          <text class="qdm-arrow">›</text>
        </view>
        <button class="qdm-done-btn touch-active" bindtap="closeQuickDecisionModal">完成</button>
      </view>
    </view>
  </view>
</view>