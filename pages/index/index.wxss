.container {
  min-height: 100vh;
  background-color: #F4F8F5;
  padding: 20rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* ================= 1. 品牌与格调顶栏 ================= */
.brand-hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 6rpx 24rpx;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-logo-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.brand-badge-icon {
  font-size: 36rpx;
  line-height: 1;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #064E3B;
  letter-spacing: 1rpx;
}

.brand-sub-badge {
  font-size: 19rpx;
  font-weight: 700;
  color: #047857;
  background: #D1FAE5;
  padding: 3rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #86EFAC;
}

.brand-slogan-row {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.brand-slogan {
  font-size: 24rpx;
  color: #059669;
  font-weight: 600;
  letter-spacing: 1.5rpx;
  margin-left: 54rpx;
}

.brand-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  box-shadow: 0 4rpx 12rpx rgba(6, 78, 59, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.brand-icon-btn:active {
  background: #ECFDF5;
  border-color: #A7F3D0;
}

.brand-action-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.brand-refresh-img {
  width: 34rpx;
  height: 34rpx;
}

.rotating {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ================= 通用栏目头部 ================= */
.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.st-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.st-icon {
  font-size: 32rpx;
}

.st-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

.st-count {
  font-size: 24rpx;
  font-weight: 700;
  color: #059669;
}

.st-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.st-history-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  border: 1rpx solid #CBD5E1;
  border-radius: 18rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #334155;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.shb-icon {
  font-size: 22rpx;
}

.shb-count {
  font-size: 20rpx;
  color: #059669;
  font-weight: 700;
}

.st-add-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  border-radius: 18rpx;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.28);
}

.sab-icon {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

/* ================= 2. 旅游记账 · 旅行小队工作台 (HERO) ================= */
.travel-hero-section {
  margin-bottom: 30rpx;
}

/* 进行中行程卡片 (山野营地护照风格) */
.trip-hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #064E3B 0%, #065F46 55%, #047857 100%);
  border-radius: 28rpx;
  padding: 30rpx 28rpx 24rpx;
  color: #FFFFFF;
  box-shadow: 0 14rpx 36rpx -8rpx rgba(6, 78, 59, 0.38);
  margin-bottom: 18rpx;
}

.trip-hero-card::before {
  content: "";
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(52, 211, 153, 0.18) 0%, rgba(52, 211, 153, 0) 70%);
  pointer-events: none;
}

.thc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.thc-header-left {
  flex: 1;
  margin-right: 16rpx;
}

.thc-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.thc-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.thc-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #A7F3D0;
  font-weight: 600;
}

.status-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 10rpx #34D399;
}

.thc-meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.thc-dest {
  font-size: 23rpx;
  color: #A7F3D0;
  font-weight: 600;
}

.thc-dates {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.75);
}

.thc-header-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.thc-del-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thc-del-icon {
  font-size: 24rpx;
  line-height: 1;
}

/* 卡片中部对账统计面板 */
.thc-dashboard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  position: relative;
  z-index: 1;
}

.thc-dash-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dash-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.76);
  margin-bottom: 6rpx;
}

.dash-val-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  height: 48rpx;
  width: 100%;
}

.dash-val-row.dash-status-row {
  align-items: center;
}

.dash-unit {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.dash-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.dash-unit-sub {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.thc-dash-divider {
  width: 2rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, 0.18);
  margin: 0 10rpx;
}

.dash-status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 21rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  line-height: 1;
  white-space: nowrap;
}

.dash-status-tag.settled {
  background: rgba(52, 211, 153, 0.25);
  color: #6EE7B7;
  border: 1rpx solid rgba(52, 211, 153, 0.4);
}

.dash-status-tag.pending {
  background: rgba(245, 158, 11, 0.3);
  color: #FCD34D;
  border: 1rpx solid rgba(245, 158, 11, 0.45);
}

/* 卡片底部操作栏 */
.thc-actions-bar {
  display: flex;
  gap: 12rpx;
  align-items: center;
  position: relative;
  z-index: 1;
}

.thc-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.thc-action-btn.primary-action {
  flex: 1.25;
  background: #FFFFFF;
  color: #065F46;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.15);
  border: none;
}

.thc-action-btn.primary-action .tab-text {
  color: #065F46;
}

.thc-action-btn.detail-action {
  flex: 0.95;
  color: #A7F3D0;
}

.tab-icon {
  font-size: 22rpx;
}

.tab-text {
  font-size: 23rpx;
}

.tab-arrow {
  font-size: 24rpx;
  line-height: 1;
  margin-left: 2rpx;
}

/* 口令加入小队通栏 */
.join-quick-strip {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 22rpx 26rpx;
  border: 1rpx dashed #86EFAC;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.jqs-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.jqs-icon-box {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #ECFDF5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border: 1rpx solid #A7F3D0;
}

.jqs-text-wrap {
  display: flex;
  flex-direction: column;
}

.jqs-main {
  font-size: 26rpx;
  font-weight: 700;
  color: #065F46;
}

.jqs-sub {
  font-size: 21rpx;
  color: #64748B;
  margin-top: 2rpx;
}

.jqs-arrow {
  font-size: 24rpx;
  font-weight: 700;
  color: #059669;
  background: #F0FDF4;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #A7F3D0;
}

/* 无进行中行程时的宣传大卡片 */
.nature-promo-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 55%, #E6F7EC 100%);
  border: 2rpx solid #86EFAC;
  border-radius: 30rpx;
  padding: 34rpx 30rpx 30rpx;
  box-shadow: 0 10rpx 26rpx -4rpx rgba(16, 185, 129, 0.12);
}

.npc-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.npc-badge {
  font-size: 21rpx;
  font-weight: 700;
  color: #047857;
  background: #D1FAE5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #A7F3D0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.npc-history-link {
  font-size: 22rpx;
  font-weight: 600;
  color: #059669;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFFFFF;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid #A7F3D0;
}

.nhl-icon {
  font-size: 20rpx;
}

.nhl-count {
  font-size: 20rpx;
  font-weight: 700;
}

.nhl-arrow {
  font-size: 22rpx;
  line-height: 1;
}

.npc-content {
  margin-bottom: 28rpx;
}

.npc-headline {
  font-size: 38rpx;
  font-weight: 900;
  color: #064E3B;
  margin-bottom: 8rpx;
  display: block;
  letter-spacing: 0.5rpx;
}

.npc-subline {
  font-size: 24rpx;
  color: #059669;
  margin-bottom: 24rpx;
  display: block;
}

.npc-features-grid {
  display: flex;
  gap: 14rpx;
}

.npc-feat-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #BBF7D0;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.05);
}

.nfi-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.nfi-txt {
  font-size: 21rpx;
  font-weight: 600;
  color: #166534;
}

.npc-actions-row {
  display: flex;
  gap: 18rpx;
}

.npc-btn-primary {
  flex: 1.3;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  padding: 22rpx 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 22rpx rgba(16, 185, 129, 0.32);
}

.npc-btn-secondary {
  flex: 1;
  background: #FFFFFF;
  color: #059669;
  font-size: 28rpx;
  font-weight: 700;
  padding: 22rpx 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid #86EFAC;
}

/* ================= 3. 日常个人账本 (次要收拢模块) ================= */
.personal-ledger-section {
  margin-bottom: 30rpx;
}

.st-chart-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 23rpx;
  color: #059669;
  font-weight: 600;
  background: #ECFDF5;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #A7F3D0;
}

.scl-icon {
  font-size: 22rpx;
}

.scl-arrow {
  font-size: 24rpx;
  line-height: 1;
}

.ledger-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
}

.ledger-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.balance-meta {
  display: flex;
  flex-direction: column;
}

.balance-caption {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.balance-figure-row {
  display: flex;
  align-items: baseline;
}

.b-currency {
  font-size: 32rpx;
  font-weight: 700;
  color: #064E3B;
  margin-right: 4rpx;
}

.b-number {
  font-size: 52rpx;
  font-weight: 800;
  color: #064E3B;
  line-height: 1;
}

.ledger-sub-stats {
  display: flex;
  gap: 24rpx;
}

.sub-stat-item {
  display: flex;
  flex-direction: column;
}

.ss-label-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 4rpx;
}

.ss-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.income-dot {
  background: #10B981;
}

.expense-dot {
  background: #F43F5E;
}

.ss-label {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 500;
}

.ss-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

/* 快捷记账双按钮 */
.ledger-action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  margin-bottom: 22rpx;
}

.lar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #F1F5F9;
}

.expense-btn {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F6 100%);
  border-color: #FFE4E6;
}

.income-btn {
  background: linear-gradient(135deg, #FFFFFF 0%, #F0FDF4 100%);
  border-color: #DCFCE7;
}

.lar-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.exp-wrap {
  background: rgba(244, 63, 94, 0.12);
}

.inc-wrap {
  background: rgba(16, 185, 129, 0.12);
}

.lar-img {
  width: 40rpx;
  height: 40rpx;
}

.lar-info {
  display: flex;
  flex-direction: column;
}

.lar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 2rpx;
}

.lar-sub {
  font-size: 20rpx;
  color: #94A3B8;
}

/* 紧凑月度预算栏 */
.ledger-budget-strip {
  background: #F8FAFC;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #F1F5F9;
}

.lbs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lbs-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.lbs-icon {
  font-size: 24rpx;
}

.lbs-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}

.lbs-status-tag {
  font-size: 19rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.lbs-status-tag.normal {
  background: #DCFCE7;
  color: #059669;
}

.lbs-status-tag.warning {
  background: #FEF3C7;
  color: #D97706;
}

.lbs-status-tag.danger {
  background: #FFE4E6;
  color: #E11D48;
}

.lbs-val-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.lbs-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.lbs-arrow {
  font-size: 28rpx;
  color: #94A3B8;
  line-height: 1;
}

.lbs-progress-track {
  width: 100%;
  height: 10rpx;
  background: #E2E8F0;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 14rpx;
  margin-bottom: 10rpx;
}

.lbs-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.4s ease;
}

.lbs-progress-bar.normal {
  background: linear-gradient(90deg, #10B981 0%, #059669 100%);
}

.lbs-progress-bar.warning {
  background: linear-gradient(90deg, #F59E0B 0%, #D97706 100%);
}

.lbs-progress-bar.danger {
  background: linear-gradient(90deg, #F43F5E 0%, #E11D48 100%);
}

.lbs-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lbs-spent {
  font-size: 20rpx;
  color: #94A3B8;
}

.lbs-rem {
  font-size: 20rpx;
  font-weight: 600;
}

.lbs-rem.normal {
  color: #059669;
}

.lbs-rem.warning {
  color: #D97706;
}

.lbs-rem.danger {
  color: #E11D48;
}

.lbs-empty {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

.lbs-empty-tip {
  font-size: 22rpx;
  color: #94A3B8;
}

.lbs-empty-link {
  font-size: 22rpx;
  font-weight: 600;
  color: #059669;
}

/* ================= 4. 最近明细列表 ================= */
.recent-bills-section {
  margin-bottom: 30rpx;
}

.st-more-link {
  font-size: 23rpx;
  color: #64748B;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.sml-arrow {
  font-size: 24rpx;
  line-height: 1;
}

.bills-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid #E2E8F0;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.bill-row {
  display: flex;
  align-items: center;
  padding: 22rpx 6rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.bill-row:last-child {
  border-bottom: none;
}

.bill-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.bill-avatar.income {
  background: #ECFDF5;
  color: #059669;
}

.bill-avatar.expense {
  background: #FFF1F2;
  color: #F43F5E;
}

.bill-avatar .iconfont {
  font-size: 38rpx;
}

.bill-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bill-cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 4rpx;
}

.bill-date {
  font-size: 21rpx;
  color: #94A3B8;
}

.bill-val-box {
  text-align: right;
}

.bill-val {
  font-size: 32rpx;
  font-weight: 700;
}

.bill-val.income {
  color: #059669;
}

.bill-val.expense {
  color: #F43F5E;
}

.bills-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0 50rpx;
}

.empty-img {
  width: 140rpx;
  height: 140rpx;
  opacity: 0.65;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #64748B;
  margin-bottom: 6rpx;
}

.empty-sub {
  font-size: 22rpx;
  color: #94A3B8;
}

/* ================= 5. 口令加入小队弹窗 ================= */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.58);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-box {
  background: #FFFFFF;
  border-radius: 30rpx;
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 44rpx rgba(15, 23, 42, 0.2);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: #64748B;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-field {
  margin-bottom: 22rpx;
}

.modal-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 10rpx;
  display: block;
}

.modal-input {
  background: #F8FAFC;
  border: 1rpx solid #CBD5E1;
  border-radius: 16rpx;
  height: 84rpx;
  min-height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0F172A;
  box-sizing: border-box;
  width: 100%;
}

.code-inp {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #059669;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.m-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
}

.m-btn.cancel {
  background: #F1F5F9;
  color: #64748B;
}

.m-btn.confirm {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
}

.queried-trip-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #F0FDF4 0%, #ECFDF5 100%);
  border: 1rpx solid #A7F3D0;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.q-trip-main {
  flex: 1;
  overflow: hidden;
  margin-right: 16rpx;
}

.q-trip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #065F46;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4rpx;
}

.q-trip-meta {
  display: block;
  font-size: 22rpx;
  color: #047857;
}

.q-trip-reset {
  font-size: 22rpx;
  font-weight: 600;
  color: #059669;
  background: #FFFFFF;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #6EE7B7;
  white-space: nowrap;
}

.modal-field-group {
  margin-bottom: 16rpx;
}

.modal-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.member-claim-scroll {
  max-height: 380rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 18rpx;
  background: #F8FAFC;
  padding: 12rpx;
  box-sizing: border-box;
}

.member-claim-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-claim-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  transition: all 0.2s ease;
}

.member-claim-item.selected {
  border-color: #10B981;
  background: #F0FDF4;
}

.member-claim-item.new-member-item {
  border-style: dashed;
  background: #FAFAFA;
}

.member-claim-item.new-member-item.selected {
  border-style: solid;
  border-color: #10B981;
  background: #F0FDF4;
}

.m-radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.m-radio.checked {
  background: #10B981;
  border-color: #10B981;
}

.m-radio-inner {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.m-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-claim-item.selected .m-name {
  color: #065F46;
  font-weight: 700;
}

.new-member-input-box {
  margin-top: 16rpx;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ================= 6. 首页快速决策投票弹窗 ================= */
.quick-decision-mask {
  z-index: 1000;
}

.quick-decision-modal {
  background: #FFFFFF;
  border-radius: 32rpx;
  width: 100%;
  max-width: 660rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.25);
  animation: modalPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.qdm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.qdm-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.qdm-trip-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #065F46;
  background: #D1FAE5;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.qdm-my-identity {
  font-size: 22rpx;
  color: #64748B;
}

.qdm-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748B;
  font-size: 26rpx;
  font-weight: 700;
}

.qdm-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.qdm-icon {
  font-size: 36rpx;
}

.qdm-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
}

.qdm-sub {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 24rpx;
}

.qdm-options-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 520rpx;
  overflow-y: auto;
  margin-bottom: 28rpx;
}

.qdm-opt-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.qdm-opt-card.active {
  background: #ECFDF5;
  border-color: #10B981;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.15);
}

.qdm-opt-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.qdm-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  transition: all 0.2s;
}

.qdm-radio.checked {
  background: #10B981;
  border-color: #10B981;
}

.qdm-opt-text {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

.qdm-opt-card.active .qdm-opt-text {
  color: #065F46;
  font-weight: 700;
}

.qdm-opt-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.qdm-vote-count {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 600;
}

.qdm-my-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #10B981;
  background: rgba(16, 185, 129, 0.15);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.qdm-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #F1F5F9;
}

.qdm-detail-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #059669;
  font-weight: 600;
}

.qdm-arrow {
  font-size: 28rpx;
}

.qdm-done-btn {
  background: #10B981;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 20rpx;
  margin: 0;
  line-height: 1.5;
}