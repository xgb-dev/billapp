.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.status-bar {
  height: var(--status-bar-height);
  background-color: #4caf50;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: white;
}

.month-picker {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #333;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 10rpx;
}

.filter-tabs {
  display: flex;
}

.filter-tab {
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  color: #666;
}

.filter-tab.active {
  color: #4caf50;
  font-weight: bold;
  position: relative;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #4caf50;
  border-radius: 2rpx;
}

.summary-card {
  display: flex;
  justify-content: space-around;
  background-color: white;
  margin: 20rpx;
  padding: 30rpx 0;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.summary-item {
  text-align: center;
}

.summary-label {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.summary-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 10rpx;
  display: block;
}

.summary-value.income {
  color: #4caf50;
}

.summary-value.expense {
  color: #f44336;
}

.summary-value.balance {
  color: #333;
}

.bill-list {
  flex: 1;
}

.date-group-header {
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  color: #999;
  background-color: #f9f9f9;
}

.bill-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  background-color: white;
  border-bottom: 1px solid #f5f5f5;
}

.bill-icon {
  width: 60rpx;
  height: 60rpx;
  font-size: 50rpx;
  margin-right: 20rpx;
}

.bill-info {
  flex: 1;
}

.bill-category {
  font-size: 30rpx;
  color: #333;
}

.bill-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 5rpx;
  display: block;
}

.bill-amount {
  font-size: 30rpx;
  font-weight: bold;
}

.bill-amount.income {
  color: #4caf50;
}

.bill-amount.expense {
  color: #f44336;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.add-btn {
  background-color: #4caf50;
  color: white;
  border-radius: 50rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}